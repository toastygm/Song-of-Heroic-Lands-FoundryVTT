<header class="sheet-header flexrow">
    <img class="item-img" src="{{itemImg}}" data-edit="img" alt="{{itemName}}" />
    <div class="sheet-header__details">
        <div class="sheet-header__identity">
            <input class="sheet-header__name-input" name="name" type="text" value="{{itemName}}"
                placeholder="{{localize 'Name'}}" />
            <input class="sheet-header__shortcode" name="system.shortcode" type="text"
                value="{{logic.data.shortcode}}" placeholder="{{localize "SOHL.Common.shortcode"}}" />
            {{> archetypeField canMarkArchetype=canMarkArchetype templatePriority=templatePriority}}
        </div>
        <div class="sheet-header__type item-subtitle">{{typeLabel}}</div>
    </div>
</header>
