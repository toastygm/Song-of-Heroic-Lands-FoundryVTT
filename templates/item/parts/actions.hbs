<section class="tab actions{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="actions">

    {{!-- Custom (script) actions — each bound to a Macro; GM-editable (#501) --}}
    <div class="search-items">
        <input class="search-criteria" type="search" name="search-actions" value=""
            aria-label="{{localize "SOHL.Action.search"}}" placeholder="{{localize "SOHL.Action.search"}}" autocomplete="off" />
    </div>

    <div class="section-legend">
        <span class="section-legend__name">{{localize "SOHL.Action.custom"}}</span>
        <span class="section-legend__rule"></span>
        <span class="section-legend__add">
            <a class="add-button action-create" data-action="createAction" data-tooltip="{{localize "SOHL.Action.create"}}">
                <i class="fa-solid fa-file-circle-plus"></i>
                <span>{{localize "SOHL.Action.create"}}</span>
            </a>
        </span>
    </div>
    <div class="ledger" style="--ledger-cols:1.5rem minmax(150px,1fr) 6rem 1fr 5rem">
        <div class="ledger__head">
            <div></div>
            <div>{{localize "SOHL.Action.colAction"}}</div>
            <div>{{localize "SOHL.ContextMenu.SortGroup.label"}}</div>
            <div>{{localize "SOHL.Item.FIELDS.notes.label"}}</div>
            <div></div>
        </div>
        {{#each customActions as |action|}}
        <div class="ledger__row" data-search-name="{{localize action.data.title}}" data-action-name="{{action.data.shortcode}}">
            {{!-- Actions carry a FontAwesome/ginf class, not an image (#1136);
                 fall back to the schema's placeholder glyph when blank. --}}
            <div class="ledger__icon"><i class="{{#if action.data.iconFAClass}}{{action.data.iconFAClass}}{{else}}fa-solid fa-circle-question{{/if}}"></i></div>
            <div class="ledger__name">{{localize action.data.title}}</div>
            <div class="ledger__cell ledger__cell--text">{{localize (concat "SOHL.ContextMenu.SortGroup." action.data.group)}}</div>
            <div class="ledger__notes"></div>
            <div class="ledger__controls">
                <a class="icon-button" data-action="editAction" title="{{localize "SOHL.Action.editMacro"}}">
                    <i class="fa-solid fa-file-code"></i>
                </a>
                <a class="icon-button icon-button--danger" data-action="deleteAction" title="{{localize "SOHL.Action.remove"}}">
                    <i class="fa-solid fa-trash"></i>
                </a>
                {{!-- A gated action (its trigger currently refuses it) reads as
                     disabled and says why, rather than offering a control that
                     silently does nothing (#1135). --}}
                <a class="icon-button" data-action="runAction" data-tooltip="{{#if action.available}}{{localize "SOHL.Action.run" name=(localize action.data.title)}}{{else}}{{localize action.unavailableReason}}{{/if}}"{{#unless action.available}} disabled aria-disabled="true"{{/unless}}>
                    <i class="fa-solid fa-play"></i>
                </a>
            </div>
        </div>
        {{/each}}
    </div>

    {{!-- Intrinsic actions --}}
    <div class="section-legend">
        <span class="section-legend__name">{{localize "SOHL.Action.intrinsic"}}</span>
        <span class="section-legend__meta">{{localize "SOHL.Action.readOnly"}}</span>
        <span class="section-legend__rule"></span>
    </div>
    <div class="ledger" style="--ledger-cols:1.5rem minmax(150px,1fr) 6rem 1fr 2rem">
        <div class="ledger__head">
            <div></div>
            <div>{{localize "SOHL.Action.colAction"}}</div>
            <div>{{localize "SOHL.ContextMenu.SortGroup.label"}}</div>
            <div>{{localize "SOHL.Item.FIELDS.notes.label"}}</div>
            <div></div>
        </div>
        {{#each intrinsicActions as |action|}}
        <div class="ledger__row" data-search-name="{{localize action.data.title}}" data-action-name="{{action.data.shortcode}}">
            {{!-- Actions carry a FontAwesome/ginf class, not an image (#1136);
                 fall back to the schema's placeholder glyph when blank. --}}
            <div class="ledger__icon"><i class="{{#if action.data.iconFAClass}}{{action.data.iconFAClass}}{{else}}fa-solid fa-circle-question{{/if}}"></i></div>
            <div class="ledger__name">{{localize action.data.title}}</div>
            <div class="ledger__cell ledger__cell--text">{{localize (concat "SOHL.ContextMenu.SortGroup." action.data.group)}}</div>
            <div class="ledger__notes"></div>
            <div class="ledger__controls">
                {{!-- A gated action (its trigger currently refuses it) reads as
                     disabled and says why, rather than offering a control that
                     silently does nothing (#1135). --}}
                <a class="icon-button" data-action="runAction" data-tooltip="{{#if action.available}}{{localize "SOHL.Action.run" name=(localize action.data.title)}}{{else}}{{localize action.unavailableReason}}{{/if}}"{{#unless action.available}} disabled aria-disabled="true"{{/unless}}>
                    <i class="fa-solid fa-play"></i>
                </a>
            </div>
        </div>
        {{/each}}
    </div>
</section>
