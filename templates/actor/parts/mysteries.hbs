<section class="tab mysteries{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="mysteries">
    {{!-- Mysteries --}}
    <div class="search-items">
        <input class="search-criteria" type="search" name="search-mysteries" value=""
            aria-label="{{localize "SOHL.Mystery.Search.label"}}" placeholder="{{localize "SOHL.Mystery.Search.label"}}" autocomplete="off" />
    </div>

    <div class="section-legend">
        <span class="section-legend__name">{{localize "TYPES.Item.mysteryPl"}}</span>
        <span class="section-legend__rule"></span>
    </div>

    <div class="mysteries-list">
        {{#each mysterySections as |section|}}
            {{#if section.items.length}}
            <div class="section-legend section-legend--subtype">
                <span class="section-legend__name">{{section.label}}</span>
                <span class="section-legend__meta">{{section.items.length}}</span>
                <span class="section-legend__rule"></span>
                <span class="section-legend__add">
                    <a class="item-create add-button add-button--small" data-action="createItem"
                        data-type="mystery" data-sub-type="{{section.subType}}"
                        data-tooltip="{{localize "SOHL.Mystery.Action.addSubType" subType=section.label}}">
                        <i class="fa-solid fa-file-circle-plus"></i><span>{{localize "SOHL.Mystery.Action.addSubType" subType=section.label}}</span>
                    </a>
                </span>
            </div>
            <div class="ledger" style="--ledger-cols:1.5rem minmax(140px,1.4fr) 6rem 6rem 3.6rem 4rem 1fr 1.6rem">
                <div class="ledger__head">
                    <div></div>
                    <div>{{localize "SOHL.Mystery.Column.mystery"}}</div>
                    <div>{{localize "SOHL.Mystery.Column.skill"}}</div>
                    <div>{{localize "SOHL.Mystery.Column.affiliation"}}</div>
                    <div class="ledger__head-num">{{localize "SOHL.Mystery.Column.level"}}</div>
                    <div class="ledger__head-num">{{localize "SOHL.Mystery.Column.charges"}}</div>
                    <div>{{localize "SOHL.Item.FIELDS.notes.label"}}</div>
                    <div></div>
                </div>
                {{#each section.items as |mystery|}}
                <li class="ledger__row item" data-search-name="{{mystery.name}}" data-item-id="{{mystery.id}}" data-item-name="{{mystery.name}}">
                    <div class="ledger__icon default-action">
                        <img src="{{mystery.img}}" alt="" />
                    </div>
                    <div class="ledger__name default-action" data-tooltip="{{mystery.name}}">{{mystery.name}}</div>
                    <div class="ledger__cell ledger__cell--text">{{#if mystery.logic.assocSkill}}{{mystery.logic.assocSkill.name}}{{/if}}</div>
                    {{!-- Affiliation (#1076): the faction whose standing confers
                          this mystery; blank when none is associated. --}}
                    <div class="ledger__cell ledger__cell--text">{{#if mystery.logic.affiliation}}{{mystery.logic.affiliation.name}}{{/if}}</div>
                    <div class="ledger__cell{{#if mystery.logic.level.disabled}} ledger__cell--dim{{/if}}"
                        data-tooltip="{{mystery.logic.level.deltaLabel}}" data-tooltip-direction="UP">
                        {{!-- Level: "×" when disabled (levelBase null), else signed value --}}
                        {{#if mystery.logic.level.disabled}}
                        <i class="fa-solid fa-xmark fa-lg"></i>
                        {{else}}
                        {{numberFormat mystery.logic.level.effective sign=true}}
                        {{/if}}
                    </div>
                    <div class="ledger__cell{{#if mystery.logic.charges.max.disabled}} ledger__cell--dim{{/if}}"
                        data-tooltip="{{mystery.logic.charges.value.deltaLabel}}" data-tooltip-direction="UP">
                        {{!-- Charges display rules (#310), first match wins:
                              max disabled → "×"; value disabled → "∞";
                              max 0 → "<value>/∞"; else "<value>/<max>" --}}
                        {{#if mystery.logic.charges.max.disabled}}
                        <i class="fa-solid fa-xmark fa-lg"></i>
                        {{else}}
                        {{#if mystery.logic.charges.value.disabled}}
                        &infin;
                        {{else}}
                        {{mystery.logic.charges.value.effective}}/{{#if (eq mystery.logic.charges.max.effective 0)}}&infin;{{else}}{{numberFormat mystery.logic.charges.max.effective}}{{/if}}
                        {{/if}}
                        {{/if}}
                    </div>
                    <div class="ledger__notes">{{mystery.system.notes}}</div>
                    <div class="ledger__controls">
                        <a class="icon-button item-contextmenu" title="{{localize "SOHL.Common.menu"}}"><i class="fa-solid fa-ellipsis-vertical fa-fw"></i></a>
                    </div>
                </li>
                {{/each}}
            </div>
            {{/if}}
        {{/each}}
    </div>
    <div class="add-footer">
        <a class="item-create add-button" data-action="createItem" data-type="mystery" data-tooltip="{{localize "SOHL.Mystery.Action.add"}}">
            <i class="fa-solid fa-file-circle-plus"></i><span>{{localize "SOHL.Mystery.Action.add"}}</span>
        </a>
    </div>

    {{!-- Mystical Abilities --}}
    <div class="search-items">
        <input class="search-criteria" type="search" name="search-mysticalabilities" value=""
            aria-label="{{localize "SOHL.MysticalAbility.Search.label"}}" placeholder="{{localize "SOHL.MysticalAbility.Search.label"}}" autocomplete="off" />
    </div>

    <div class="section-legend">
        <span class="section-legend__name">{{localize "TYPES.Item.mysticalabilityPl"}}</span>
        <span class="section-legend__rule"></span>
    </div>

    <div class="mysticalabilities-list">
        {{#each abilitySections as |section|}}
            {{#if section.items.length}}
            <div class="section-legend section-legend--subtype">
                <span class="section-legend__name">{{section.label}}</span>
                <span class="section-legend__meta">{{section.items.length}}</span>
                <span class="section-legend__rule"></span>
                <span class="section-legend__add">
                    <a class="item-create add-button add-button--small" data-action="createItem"
                        data-type="mysticalability" data-sub-type="{{section.subType}}"
                        data-tooltip="{{localize "SOHL.MysticalAbility.Action.addSubType" subType=section.label}}">
                        <i class="fa-solid fa-file-circle-plus"></i><span>{{localize "SOHL.MysticalAbility.Action.addSubType" subType=section.label}}</span>
                    </a>
                </span>
            </div>
            {{!-- Each sub-type renders only its own columns (#990); the column
            set + ledger grid come pre-built from being-sheet-view
            (MYSTICALABILITY_SUBTYPE_COLUMNS). --}}
            <div class="ledger" style="--ledger-cols:{{section.ledgerCols}}">
                <div class="ledger__head">
                    <div></div>
                    <div>{{localize "SOHL.MysticalAbility.COLUMN.ability"}}</div>
                    {{#each section.columns as |col|}}
                    <div class="{{col.headClass}}"{{#if col.tooltipKey}} data-tooltip="{{localize col.tooltipKey}}"{{/if}}>{{localize col.labelKey}}</div>
                    {{/each}}
                    <div></div>
                </div>
                {{#each section.items as |ability|}}
                {{!-- A disabled ability — out of charges, or a spirit-power
                subtype without a valid Spirit Power — is greyed out and its EML
                roll is blocked until the condition clears (#990). --}}
                <li class="ledger__row item{{#if ability.logic.isDisabled}} ledger__row--disabled{{/if}}" data-search-name="{{ability.name}}" data-item-id="{{ability.id}}" data-item-name="{{ability.name}}">
                    <div class="ledger__icon default-action">
                        <img src="{{ability.img}}" alt="" />
                    </div>
                    <div class="ledger__name default-action" data-tooltip="{{ability.name}}">{{ability.name}}</div>
                    {{#each section.columns as |col|}}
                        {{#if (eq col.kind "skill")}}
                        {{!-- Assoc column (Skill, or "Spirit Power" for the
                              spirit-power subtypes): the reference's name, or
                              "✕" when none is associated. --}}
                        <div class="ledger__cell ledger__cell--text{{#unless ability.logic.assocRef}} ledger__cell--dim{{/unless}}">
                            {{#if ability.logic.assocRef}}{{ability.logic.assocRef.name}}{{else}}<i class="fa-solid fa-xmark fa-lg"></i>{{/if}}
                        </div>
                        {{else if (eq col.kind "affiliation")}}
                        {{!-- Affiliation column (#1012): the associated faction's
                              name, or "✕" when none is associated. --}}
                        <div class="ledger__cell ledger__cell--text{{#unless ability.logic.affiliation}} ledger__cell--dim{{/unless}}">
                            {{#if ability.logic.affiliation}}{{ability.logic.affiliation.name}}{{else}}<i class="fa-solid fa-xmark fa-lg"></i>{{/if}}
                        </div>
                        {{else if (eq col.kind "level")}}
                        <div class="ledger__cell{{#if ability.logic.level.disabled}} ledger__cell--dim{{/if}}"
                            data-tooltip="{{ability.logic.level.deltaLabel}}" data-tooltip-direction="UP">
                            {{!-- Level: "×" when disabled (levelBase null), else value --}}
                            {{#if ability.logic.level.disabled}}
                            <i class="fa-solid fa-xmark fa-lg"></i>
                            {{else}}
                            {{ability.logic.level.effective}}
                            {{/if}}
                        </div>
                        {{else if (eq col.kind "eml")}}
                        {{#if ability.logic.isDisabled}}
                        {{!-- Disabled: EML shown but not rollable. --}}
                        <div class="ledger__cell ledger__cell--dim"
                            data-tooltip="{{ability.logic.masteryLevel.deltaLabel}}" data-tooltip-direction="UP">
                            {{#if ability.logic.masteryLevel.disabled}}
                            <i class="fa-solid fa-xmark fa-lg"></i>
                            {{else}}
                            {{ability.logic.masteryLevel.effective}}
                            {{/if}}
                        </div>
                        {{else}}
                        <div class="ledger__cell ledger__cell--rollable{{#if ability.logic.masteryLevel.disabled}} ledger__cell--dim{{/if}}"
                            data-action="successTest"
                            data-tooltip="{{ability.logic.masteryLevel.deltaLabel}}" data-tooltip-direction="UP">
                            {{#if ability.logic.masteryLevel.disabled}}
                            <i class="fa-solid fa-xmark fa-lg"></i>
                            {{else}}
                            {{ability.logic.masteryLevel.effective}}
                            {{/if}}
                        </div>
                        {{/if}}
                        {{else if (eq col.kind "charges")}}
                        <div class="ledger__cell{{#if ability.logic.charges.max.disabled}} ledger__cell--dim{{/if}}"
                            data-tooltip="{{ability.logic.charges.value.deltaLabel}}" data-tooltip-direction="UP">
                            {{!-- Chgs/Max display rules (#990), first match wins:
                                  charges disabled (doesn't use charges) → "✕";
                                  infinite remaining → "∞"; infinite max → "<value>/∞";
                                  else "<value>/<max>". --}}
                            {{#if ability.logic.charges.max.disabled}}
                            <i class="fa-solid fa-xmark fa-lg"></i>
                            {{else}}
                            {{#if ability.logic.charges.value.disabled}}
                            <i class="fa-solid fa-infinity"></i>
                            {{else}}
                            {{ability.logic.charges.value.effective}}/{{#if (eq ability.logic.charges.max.effective 0)}}<i class="fa-solid fa-infinity"></i>{{else}}{{numberFormat ability.logic.charges.max.effective}}{{/if}}
                            {{/if}}
                            {{/if}}
                        </div>
                        {{else}}
                        <div class="ledger__notes" data-tooltip="{{ability.system.notes}}">{{ability.system.notes}}</div>
                        {{/if}}
                    {{/each}}
                    <div class="ledger__controls">
                        {{!-- The ☆ star is shown only on an ability that has a
                              mastery level of its own to raise (#1130): one
                              drawing on an associated Skill or Spirit Power
                              improves when that item does. --}}
                        {{#if ability.logic.canImprove}}
                        <a class="icon-button toggle-improve-flag{{#if ability.system.improveFlag}} icon-button--on{{/if}}" data-action="toggleImproveFlag" title="{{localize "SOHL.Common.improve"}}">
                            <i class="{{#if ability.system.improveFlag}}fa-solid fa-circle-up ledger__flag{{else}}fa-regular fa-circle{{/if}}"></i>
                        </a>
                        {{/if}}
                        <a class="icon-button item-contextmenu" title="{{localize "SOHL.Common.menu"}}"><i class="fa-solid fa-ellipsis-vertical fa-fw"></i></a>
                    </div>
                </li>
                {{/each}}
            </div>
            {{/if}}
        {{/each}}
    </div>
    <div class="add-footer">
        <a class="item-create add-button" data-action="createItem" data-type="mysticalability" data-tooltip="{{localize "SOHL.MysticalAbility.Action.add"}}">
            <i class="fa-solid fa-file-circle-plus"></i><span>{{localize "SOHL.MysticalAbility.Action.add"}}</span>
        </a>
    </div>
</section>
