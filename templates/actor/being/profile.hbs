<section class="tab profile{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="profile">
    {{!-- Attributes --}}
    <div class="section-legend">
        <span class="section-legend__name">{{localize "TYPES.Item.attributePl"}}</span>
        <span class="section-legend__rule"></span>
        <span class="section-legend__add">
            <a class="add-button item-create" data-action="createItem" data-tooltip="{{localize "SOHL.Actor.SHEET.profile.addAttribute"}}" data-type="attribute">
                <i class="fa-solid fa-file-circle-plus"></i><span>{{localize "SOHL.Actor.SHEET.profile.addAttribute"}}</span>
            </a>
        </span>
    </div>
    <div class="grid grid-6col attribute-scores">
        {{#each attributes as |attr|}}
        <div class="attribute-score item" data-item-id="{{attr.id}}" data-uuid="{{attr.uuid}}" data-item-name="{{attr.name}}">
            <div class="attribute-score__header flexrow">
                <h4 class="attribute-score__name">{{attr.name}}</h4>
                <a class="icon-button item-contextmenu" title="{{localize "SOHL.Common.menu"}}"><i class="fa-solid fa-ellipsis-vertical fa-fw"></i></a>
            </div>
            <div class="attribute-score__value" data-tooltip="{{attr.scoreDeltaLabel}}" data-tooltip-direction="UP">{{attr.score}}</div>
            <div class="attribute-score__descriptor">{{attr.descriptor}}</div>
            <div class="attribute-score__tl" data-tooltip="{{attr.tlDeltaLabel}}" data-tooltip-direction="UP">{{localize "SOHL.Being.Attribute.traitLevel" value=attr.tl}}</div>
        </div>
        {{/each}}
    </div>

    {{!-- Affiliations --}}
    <div class="section-legend">
        <span class="section-legend__name">{{localize "TYPES.Item.affiliationPl"}}</span>
        <span class="section-legend__rule"></span>
        <span class="section-legend__add">
            <a class="add-button item-create" data-action="createItem" data-tooltip="{{localize 'SOHL.Affiliation.Heading.Add.label'}}" data-type="affiliation">
                <i class="fa-solid fa-file-circle-plus"></i><span>{{localize "SOHL.Affiliation.Heading.Add.label"}}</span>
            </a>
        </span>
    </div>
    <div class="ledger" style="--ledger-cols:minmax(140px,1.4fr) 2.6rem 5.5rem 5rem 5rem 1.2fr 1.8rem">
        <div class="ledger__head">
            <div></div>
            <div class="ledger__head-num">{{localize "SOHL.Affiliation.FIELDS.level.label"}}</div>
            <div>{{localize "SOHL.Affiliation.FIELDS.society.label"}}</div>
            <div>{{localize "SOHL.Affiliation.FIELDS.office.label"}}</div>
            <div>{{localize "SOHL.Affiliation.FIELDS.title.label"}}</div>
            <div>{{localize "SOHL.Item.FIELDS.notes.label"}}</div>
            <div></div>
        </div>
        {{#each affiliations as |aff|}}
        <div class="ledger__row" data-search-name="{{aff.name}}" data-item-id="{{aff.id}}" data-uuid="{{aff.uuid}}" data-item-name="{{aff.name}}">
            <div class="ledger__name">{{aff.name}}</div>
            <div class="ledger__cell">{{aff.level}}</div>
            <div class="ledger__cell ledger__cell--text">{{aff.society}}</div>
            <div class="ledger__cell ledger__cell--text">{{aff.office}}</div>
            <div class="ledger__cell ledger__cell--text">{{aff.title}}</div>
            <div class="ledger__notes" title="{{aff.notes}}">{{aff.notes}}</div>
            <div class="ledger__controls">
                <a class="icon-button item-contextmenu" title="{{localize "SOHL.Common.menu"}}"><i class="fa-solid fa-ellipsis-vertical fa-fw"></i></a>
            </div>
        </div>
        {{/each}}
    </div>

    {{!-- Movement --}}
    {{#if movement.length}}
    <div class="section-legend">
        <span class="section-legend__name">{{localize "SOHL.Actor.SHEET.tab.movement.label"}}</span>
        <span class="section-legend__meta">{{localize "SOHL.Being.movement.unit"}}</span>
        <span class="section-legend__rule"></span>
        <span class="section-legend__add">
            <a class="add-button" data-action="addMovementProfile" data-tooltip="{{localize "SOHL.Actor.SHEET.profile.addMovementProfile"}}">
                <i class="fa-solid fa-file-circle-plus"></i><span>{{localize "SOHL.Actor.SHEET.profile.addMovementProfile"}}</span>
            </a>
        </span>
    </div>
    <div class="ledger" style="--ledger-cols:minmax(140px,1fr) 6rem 1.8rem">
        <div class="ledger__head">
            <div>{{localize "SOHL.Actor.SHEET.tab.movement.label"}}</div>
            <div></div>
            <div></div>
        </div>
        {{#each movement as |row|}}
        <div class="ledger__row" data-medium="{{row.medium}}">
            <div class="ledger__name">{{localize row.label}}</div>
            <div class="ledger__cell">{{row.value}} {{localize "SOHL.Being.movement.unit"}}</div>
            <div class="ledger__controls">
                {{#if row.isCurrent}}
                <span class="icon-button is-on" data-tooltip="{{localize 'SOHL.Actor.movement.default'}}"><i class="fa-solid fa-circle-check"></i></span>
                {{else}}
                <a class="icon-button" data-action="makeDefaultMedium" data-medium="{{row.medium}}" data-tooltip="{{localize 'SOHL.Actor.movement.makeDefault'}}"><i class="fa-regular fa-circle"></i></a>
                {{/if}}
            </div>
        </div>
        {{/each}}
    </div>
    {{/if}}

    {{!-- Body Structure editor: the editable Zone → Part → Location tree.
         Collapsed by default (only zone headers shown); the toggle in the
         section legend flips every zone/part open or closed at once, and each
         zone/part also has its own chevron. Editing (#720) is owner-gated:
         + Add controls, drag-to-sort, and the ⋮ Edit/Delete menu. --}}
    {{#if structure}}
    <div class="section-legend">
        <span class="section-legend__name">{{localize "SOHL.Being.Heading.BodyStructure"}}</span>
        <span class="section-legend__meta">{{localize "SOHL.Being.BodyStructure.zoneCount" count=bodyZones.length}}</span>
        <span class="section-legend__rule"></span>
        <span class="section-legend__add">
            <button type="button" class="add-button add-button--small body-structure__toggle-all" data-action="toggleBodyStructureAll" data-state="collapsed" data-tooltip="{{localize "SOHL.Being.BodyStructure.expandAllTip"}}">
                <i class="fa-solid fa-angles-down"></i><span>{{localize "SOHL.Being.BodyStructure.expandAll"}}</span>
            </button>
            {{#if canEditBody}}
            <a class="add-button add-button--small bodyzone-add" data-action="addBodyZone" data-tooltip="{{localize "SOHL.Being.BodyStructure.addZoneTip"}}">
                <i class="fa-solid fa-plus"></i><span>{{localize "SOHL.Being.BodyStructure.addZone"}}</span>
            </a>
            {{/if}}
        </span>
    </div>
    <div class="body-structure">
        {{#each bodyZones as |zone|}}
        <div class="body-structure__zone" data-zone-shortcode="{{zone.shortcode}}" data-zone-index="{{zone.index}}"
            {{#if @root.canEditBody}}draggable="true"{{/if}}>
            <button type="button" class="disclosure" data-action="toggleZone" data-zone-shortcode="{{zone.shortcode}}" data-tooltip="{{localize "SOHL.Being.BodyStructure.expand" label=zone.label}}">
                <i class="fa-solid fa-chevron-right"></i>
            </button>
            <span class="body-structure__zone-name">{{zone.label}}</span>
            {{#if zone.zoneRange}}
            <span class="chip chip--hit" data-tooltip="{{localize "SOHL.Being.BodyStructure.zoneNumberTip"}}">{{localize "SOHL.Being.BodyStructure.zoneNumber" range=zone.zoneRange}}</span>
            {{/if}}
            <span class="body-structure__controls">
                {{#if @root.canEditBody}}
                <a class="add-button add-button--small bodypart-add" data-action="addBodyPart" data-tooltip="{{localize "SOHL.Being.BodyStructure.addPartTip"}}">
                    <i class="fa-solid fa-plus"></i><span>{{localize "SOHL.Being.BodyStructure.addPart"}}</span>
                </a>
                {{/if}}
                <a class="icon-button bodyzone-contextmenu" title="{{localize "SOHL.Common.menu"}}"><i class="fa-solid fa-ellipsis-vertical fa-fw"></i></a>
                {{#if @root.canEditBody}}
                <span class="drag-grip" data-tooltip="{{localize "SOHL.Common.dragToReorder"}}"><i class="fa-solid fa-grip-vertical"></i></span>
                {{/if}}
            </span>
        </div>
        {{#each zone.parts as |part|}}
        <div class="body-structure__part body-structure__part--collapsed" data-part-shortcode="{{part.shortcode}}" data-part-index="{{part.index}}"
            {{#if @root.canEditBody}}draggable="true"{{/if}}>
            <button type="button" class="disclosure" data-action="togglePart" data-part-shortcode="{{part.shortcode}}" data-tooltip="{{localize "SOHL.Being.BodyStructure.expand" label=part.label}}">
                <i class="fa-solid fa-chevron-right"></i>
            </button>
            <span class="body-structure__part-name">{{part.label}}</span>
            {{#if part.role}}
            <span class="chip chip--role">{{part.role}}</span>
            {{/if}}
            <span class="body-structure__controls">
                {{#if @root.canEditBody}}
                <a class="add-button add-button--small bodylocation-add" data-action="addBodyLocation" data-tooltip="{{localize "SOHL.Being.BodyStructure.addLocationTip"}}">
                    <i class="fa-solid fa-plus"></i><span>{{localize "SOHL.Being.BodyStructure.addLocation"}}</span>
                </a>
                {{/if}}
                <a class="icon-button bodypart-contextmenu" title="{{localize "SOHL.Common.menu"}}"><i class="fa-solid fa-ellipsis-vertical fa-fw"></i></a>
                {{#if @root.canEditBody}}
                <span class="drag-grip" data-tooltip="{{localize "SOHL.Common.dragToReorder"}}"><i class="fa-solid fa-grip-vertical"></i></span>
                {{/if}}
            </span>
        </div>
        {{#each part.locations as |loc|}}
        <div class="body-structure__location body-structure__location--collapsed" data-search-name="{{loc.name}}"
            data-part-shortcode="{{part.shortcode}}" data-location-shortcode="{{loc.shortcode}}"
            {{#if @root.canEditBody}}draggable="true"{{/if}}>
            {{#if @root.canEditBody}}
            <span class="drag-grip" data-tooltip="{{localize "SOHL.Common.dragToReorder"}}"><i class="fa-solid fa-grip-vertical"></i></span>
            {{/if}}
            <span class="body-structure__location-name">{{loc.name}}</span>
            <span class="body-structure__controls">
                <a class="icon-button bodylocation-contextmenu" title="{{localize "SOHL.Common.menu"}}"><i class="fa-solid fa-ellipsis-vertical fa-fw"></i></a>
            </span>
        </div>
        {{/each}}
        {{/each}}
        {{/each}}
    </div>
    {{/if}}

    {{!-- Biography --}}
    <div class="section-legend">
        <span class="section-legend__name">{{localize "SOHL.Actor.SHEET.profile.biography.label"}}</span>
    </div>
    {{formGroup fields.dossier value=system.dossier rootId="dossier" classes="stacked dossier-group" elementType="prose-mirror" }}
</section>
