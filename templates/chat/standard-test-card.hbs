<div class="sohl chat-card item-card" data-actor-uuid="{{actor.uuid}}">
    <header class="card-header">
        <h3 class="title">{{title}}
            {{!--
            GM result-edit (#856): re-evaluate this settled test on its frozen
            roll (adjust the situational / success-level modifier, no re-roll, no
            Fate cost). The pencil is render-hidden from non-GMs by
            `gateEditActionPencil`; `data-scope` carries this result serialized
            under `priorTestResult` so the click revives and re-evaluates *this*
            result. GM-refused again at click time in `resultEdit`.
            --}}
            <a class="edit-action"
                data-action="resultEdit"
                data-action-handler-uuid="{{item.uuid}}"
                data-scope="{{editScopeJSON}}"
                ><i class="fa-solid fa-pen-to-square"></i></a>
            </h3>
    </header>

    {{#if (not mlMod.empty)}}
    <div class="card-content">
        {{{mlMod.chatHtml}}}
    </div>
    {{/if}}

    <div class="card-content">
        <span class="label">{{localize "SOHL.Chat.StandardTest.target"}}</span>
        <span class="value">{{mlMod.constrainedEffective}}</span>
    </div>

    {{#if mlMod.successLevelMod}}
    <div class="card-content">
        <span class="label">{{localize "SOHL.Chat.StandardTest.successLevelMod"}}</span>
        <span class="value">{{mlMod.successLevelMod}}</span>
    </div>
    {{/if}}

    <div class="card-content">
        <span class="label">{{localize "SOHL.Chat.StandardTest.roll"}}</span>
        <span 
        {{#if isSuccess}}
        class="value success-text"
        {{else}}
        class="value failure-text"
        {{/if}}
        >{{roll.total}}</span>
    </div>    
        
    {{!--
    Success Value test (#848): the graded outcome — the Success Value (Index +
    Modifier) and the Value Diamonds (0–5), drawn as icons. The meaning of the grade is
    shown in the Result row below (resultText / resultDesc from the svTable).
    --}}
    {{#if isSuccessValue}}
    <div class="card-content">
        <span class="label">{{localize "SOHL.Chat.StandardTest.successValue"}}</span>
        <span class="value">{{successValue}}</span>
    </div>
    <div class="card-content">
        <span class="label">{{localize "SOHL.Chat.StandardTest.valueDiamonds"}}</span>
        <span class="value value-diamonds" aria-label="{{localize "SOHL.Chat.StandardTest.valueDiamondsAria" count=valueDiamonds}}">{{#each vdMarks}}<i class="{{#if this}}fa-solid{{else}}fa-regular{{/if}} fa-gem" aria-hidden="true"></i>{{/each}}</span>
    </div>
    {{/if}}

    {{#if resultText}}
    <div class="card-content">
        <span class="label">{{localize "SOHL.Chat.StandardTest.result"}}</span>
        <span
            {{#if (ifThen isSuccessValue svSuccess isSuccess)}}
            class="value success-text"
            {{else}}
            class="value failure-text"
            {{/if}}
            >{{resultText}}</span>
    </div>

    {{#if resultDesc}}
        <div class="card-content">
            <span class="value">{{resultDesc}}</span>
        </div>
    {{/if}}
    {{/if}}

    {{#if canFate}}
    <div class="card-buttons">
        <button
            class="action-card-button"
            data-action="fateTest"
            data-handler-uuid="{{item.uuid}}"
            data-scope="{{fateScopeJSON}}">{{localize "SOHL.Skill.Fate.button"}}</button>
    </div>
    {{/if}}

    {{!--
    Optional caller-supplied follow-up buttons. Same shape and markup as the
    action-card button block (`action-buttons.hbs`): each is a pre-filled
    invocation of a self-sufficient action, gated targeted-vs-open by the
    `action-card-button` class (`gateActionCardButtons`) and dispatched through
    the shared chat-card chokepoint. Folded in by `SuccessTestResult.toChat` via
    `toRenderableButtons`, so a graded success test carries its own consent
    follow-ups (#853) without a bespoke result card.
    --}}
    {{#if buttons}}
    <div class="card-buttons">
        {{#each buttons}}
        <button
            class="action-card-button"
            data-action="{{this.action}}"
            data-handler-uuid="{{this.handlerUuid}}"
            data-scope="{{this.scopeJSON}}"
            data-skip-dialog="{{this.skipDialog}}">
            {{#if this.iconFAClass}}<i class="{{this.iconFAClass}}"></i> {{/if}}{{this.label}}
        </button>
        {{/each}}
    </div>
    {{/if}}

    {{#if isSuccess}}
        {{#if isCritical}}
            <footer class="card-footer critical-success-block">
                <span>{{localize description}}</span>
            </footer>
        {{else}}
            <footer class="card-footer success-text">
                <span>{{localize description}}</span>
            </footer>
        {{/if}}
    {{else}}
        {{#if isCritical}}
            <footer class="card-footer critical-failure-block">
                <span>{{localize description}}</span>
            </footer>
        {{else}}
            <footer class="card-footer failure-text">
                <span>{{localize description}}</span>
            </footer>
        {{/if}}
    {{/if}}
</div>
